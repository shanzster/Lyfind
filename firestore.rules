rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin = has a doc in the admins collection (written only via Admin SDK)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Profiles are visible to signed-in users (names/photos shown on items).
    // Only the owner edits their own profile; role escalation is blocked —
    // role/ban/suspension fields change only via admin or the Admin SDK.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'banned', 'suspendedUntil', 'suspended']));
      allow delete: if isAdmin();
    }

    // ── Items ─────────────────────────────────────────────────────────────
    // Public read (the /public/item/:id share + QR poster pages need it).
    // Writes: owner or admin. Exception: any signed-in user may write ONLY
    // the aiFeatures cache (feature vectors are computed client-side by
    // whichever browser runs the matcher).
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['aiFeatures', 'updatedAt']));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Conversations ─────────────────────────────────────────────────────
    // Participants only; admins may monitor.
    match /conversations/{convId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();
    }

    // ── Messages ──────────────────────────────────────────────────────────
    // Readable/writable only by participants of the parent conversation
    // (looked up per document); admins may monitor. 'system' messages are
    // created by a participant's client during the claim flow.
    match /messages/{messageId} {
      function parentConv() {
        return get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data;
      }
      function newParentConv() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data;
      }
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid in parentConv().participants);
      allow create: if isSignedIn()
        && (request.resource.data.senderId == request.auth.uid
            || request.resource.data.senderId == 'system')
        && request.auth.uid in newParentConv().participants;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid in parentConv().participants);
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    // Only the recipient reads/updates/deletes. Any signed-in user may
    // create (clients notify each other, e.g. on new messages/matches).
    match /notifications/{notificationId} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // ── Bookmarks (saved items) ───────────────────────────────────────────
    // Doc id is "{uid}_{itemId}", so the id prefix authorizes access even for
    // existence checks on docs that don't exist yet (the toggle's getDoc).
    // The resource.data.userId clause keeps list queries (where userId == me)
    // provable.
    match /bookmarks/{bookmarkId} {
      allow read, delete: if isSignedIn()
        && (bookmarkId.split('_')[0] == request.auth.uid
            || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && bookmarkId.split('_')[0] == request.auth.uid;
    }

    // ── Reports ───────────────────────────────────────────────────────────
    // Users file reports about others; only admins see or act on them.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Teacher verifications ─────────────────────────────────────────────
    // Doc id == the requesting user's uid. Owner submits and tracks their
    // own request; admins review.
    match /teacherVerifications/{uid} {
      allow create, update: if isAdmin() || isSelf(uid);
      allow read: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
    }

    // ── Photo match requests ──────────────────────────────────────────────
    // The processing queue is a distributed client-side worker: whichever
    // signed-in browser is open picks up queued requests from ANY user and
    // writes results back. So reads/updates must be open to signed-in users
    // until processing moves server-side.
    match /photoMatches/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update: if isSignedIn();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Match records (auto-match + AI matching) ──────────────────────────
    // Created cross-user by whichever client runs the matcher; low
    // sensitivity (item ids + scores). Deletion is admin-only.
    match /matches/{matchId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /aiMatches/{matchId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Saved-search watches ──────────────────────────────────────────────
    // Reads are open to signed-in users because the poster's client scans
    // ALL watches to notify matching watchers (client-side worker pattern).
    match /watches/{watchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    // ── Exchange ratings ──────────────────────────────────────────────────
    // Doc id is "{conversationId}_{raterId}". Readable by signed-in users
    // (public trust signal, powers aggregate averages). Writable only by the
    // rater, one per conversation.
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.raterId == request.auth.uid
        && ratingId.split('_')[1] == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Campus announcements ──────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Guard Station pickup log ──────────────────────────────────────────
    // Only custodians write; each custodian reads their own log; admins all.
    match /guardClaims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.custodianId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'custodian';
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.custodianId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Admin infrastructure ──────────────────────────────────────────────
    // Admin docs are created/removed ONLY via the Admin SDK (seed scripts).
    // An admin may read their own doc (login check), list other admins, and
    // update their own lastLogin.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) && isAdmin();
      allow create, delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /pendingAdmins/{docId} {
      allow read, write: if isAdmin();
    }

    match /pendingUsers/{docId} {
      allow read, write: if isAdmin();
    }

    // Everything else: denied by default (no catch-all).
  }
}
